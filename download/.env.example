# Broker Credentials
IQ_EMAIL=your_iq_option_email@example.com
IQ_PASSWORD=your_iq_option_password
PO_EMAIL=your_pocket_option_email@example.com
PO_PASSWORD=your_pocket_option_password

# Broker Enable/Disable
USE_IQ_OPTION=True
USE_POCKET_OPTION=True

# Telegram Alerts
TELEGRAM_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=@YourChannelUsername

# Entry Confirmation
ENTRY_CONFIRM_ENABLED=True
ENTRY_PRICE_THRESHOLD=0.0005

# News Filter
NEWS_FILTER_ENABLED=True
NEWS_WINDOW_SECONDS=600

# Server Port (auto-set by Railway)
PORT=8000
