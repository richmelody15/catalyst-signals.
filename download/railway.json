{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildEnv": {
      "PYTHON_VERSION": "3.12"
    }
  },
  "deploy": {
    "startCommand": "uvicorn catalyst_final:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "envVars": {
      "USE_IQ_OPTION": "True",
      "USE_POCKET_OPTION": "True",
      "NEWS_FILTER_ENABLED": "True",
      "ENTRY_CONFIRM_ENABLED": "True"
    }
  }
}
